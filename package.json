{
  "name": "@forge-ahead/remote",
  "version": "0.3.0",
  "description": "Framework-neutral authentication and A2A/Rovo helpers for Atlassian Forge Remote services.",
  "private": true,
  "license": "Apache-2.0",
  "keywords": [
    "atlassian",
    "forge",
    "forge-remote",
    "a2a",
    "rovo",
    "authentication",
    "jwt"
  ],
  "homepage": "https://github.com/ibuchanan/forge-ahead-remote#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ibuchanan/forge-ahead-remote.git"
  },
  "author": "Ian Buchanan",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./jwt": {
      "import": {
        "types": "./dist/jwt.d.mts",
        "default": "./dist/jwt.mjs"
      },
      "require": {
        "types": "./dist/jwt.d.cts",
        "default": "./dist/jwt.cjs"
      }
    },
    "./context": {
      "import": {
        "types": "./dist/context.d.mts",
        "default": "./dist/context.mjs"
      },
      "require": {
        "types": "./dist/context.d.cts",
        "default": "./dist/context.cjs"
      }
    },
    "./invocation": {
      "import": {
        "types": "./dist/invocation.d.mts",
        "default": "./dist/invocation.mjs"
      },
      "require": {
        "types": "./dist/invocation.d.cts",
        "default": "./dist/invocation.cjs"
      }
    },
    "./a2a": {
      "import": {
        "types": "./dist/a2a.d.mts",
        "default": "./dist/a2a.mjs"
      },
      "require": {
        "types": "./dist/a2a.d.cts",
        "default": "./dist/a2a.cjs"
      }
    },
    "./logging": {
      "import": {
        "types": "./dist/logging.d.mts",
        "default": "./dist/logging.mjs"
      },
      "require": {
        "types": "./dist/logging.d.cts",
        "default": "./dist/logging.cjs"
      }
    },
    "./rovo": {
      "import": {
        "types": "./dist/rovo.d.mts",
        "default": "./dist/rovo.mjs"
      },
      "require": {
        "types": "./dist/rovo.d.cts",
        "default": "./dist/rovo.cjs"
      }
    },
    "./express": {
      "import": {
        "types": "./dist/express.d.mts",
        "default": "./dist/express.mjs"
      },
      "require": {
        "types": "./dist/express.d.cts",
        "default": "./dist/express.cjs"
      }
    },
    "./fastify": {
      "import": {
        "types": "./dist/fastify.d.mts",
        "default": "./dist/fastify.mjs"
      },
      "require": {
        "types": "./dist/fastify.d.cts",
        "default": "./dist/fastify.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "changelog": "touch CHANGELOG.md && git cliff --offline --unreleased --prepend CHANGELOG.md",
    "check": "npm run format:check && npm run lint:check && npm run typecheck && npm run test && npm run build",
    "clean": "rm -rf ./node_modules && rm package-lock.json && rm -rf ./dist && rm -rf .cocoindex_code",
    "dev": "tsdown --watch",
    "format": "biome format --write",
    "format:check": "biome format",
    "lint": "lefthook run lint",
    "lint:check": "biome lint",
    "lint:fix": "biome lint --write",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "prepare": "npm run build && (lefthook install || true)",
    "release:check": "npm run check && npm run test:coverage && npm run pack:check",
    "release:prepare": "scripts/release-prepare.sh",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@a2a-js/sdk": "^1.2",
    "@forge-ahead/errors": "github:ibuchanan/forge-ahead-errors",
    "jose": "^6.2",
    "zod": "^4.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/express": "^5.0",
    "@types/node": "22",
    "@vitest/coverage-v8": "^5.0",
    "express": "^5.2",
    "fastify": "^5.12",
    "lefthook": "^2.1",
    "tsdown": "^0.23",
    "typescript": "^5.9",
    "vitest": "^5.0"
  },
  "peerDependencies": {
    "express": "^4.21 || ^5.1",
    "fastify": "^5.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "fastify": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  }
}
